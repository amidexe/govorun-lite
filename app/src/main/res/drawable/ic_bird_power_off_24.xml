    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurface">
    <!-- Same bird silhouette, with a small power-off glyph in the top-right
         corner (arc with gap + centered vertical line) — used by the
         silence Quick Settings tile to signal "voice input is paused". -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M21.5,10.5 L17.5,9 C14.5,5.5 9,5.5 6,9.5 L3,8.5 L4,12.5 C5.5,15.5 9,17.5 13,17.5 C16,17.5 18,15.5 18,13 L21.5,11.5 Z" />
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M7.5,11.5 C9.5,13.5 12,14.5 15,14" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M15.2,9 m-0.7,0 a0.7,0.7 0 1,0 1.4,0 a0.7,0.7 0 1,0 -1.4,0 Z" />
    <!-- Power-off glyph: arc (gap at top) + centered vertical line through
         gap. Bigger than v1 — was barely visible at QS-tile size. Centered
         around (20.5, 3.5), radius 2.5. May slightly overlap the bird's
         head; accepted trade-off for visibility. Stroke 0.8 matches eye
         glyph thickness. -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="0.8"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M21,1.07 A2.5,2.5 0 1,1 20,1.07" />
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="0.8"
        android:strokeLineCap="round"
        android:pathData="M20.5,0 L20.5,3.5" />
</vector>
