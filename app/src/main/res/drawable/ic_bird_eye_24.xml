<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurface">
    <!-- Same bird silhouette as ic_bird_24, with a small open-eye glyph
         in the top-right corner — used by the always-show Quick Settings
         tile to signal "voice input is watching always". -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M21.5,10.5 L17.5,9 C14.5,5.5 9,5.5 6,9.5 L3,8.5 L4,12.5 C5.5,15.5 9,17.5 13,17.5 C16,17.5 18,15.5 18,13 L21.5,11.5 Z" />
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M7.5,11.5 C9.5,13.5 12,14.5 15,14" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M15.2,9 m-0.7,0 a0.7,0.7 0 1,0 1.4,0 a0.7,0.7 0 1,0 -1.4,0 Z" />
    <!-- Eye glyph in the top-right: bigger almond outline + filled pupil.
         2x larger than v1 — original was barely visible at QS-tile size.
         May slightly overlap the bird's head; that's an accepted trade-off
         for visibility at thumbnail scale (Quick Settings panel renders
         the icon at ~24dp, so any modifier under ~3 viewport units gets
         lost). Stroke 0.8 to match power-off glyph thickness. -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="0.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M17,3.5 C18.5,0.7 22.5,0.7 24,3.5 C22.5,6.3 18.5,6.3 17,3.5 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M20.5,3.5 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0 Z" />
</vector>
