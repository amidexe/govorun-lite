{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "SetupProgress": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "$ref": "#/definitions/SetupStep"
        }
      },
      "required": [
        "step"
      ],
      "type": "object"
    },
    "SetupStep": {
      "enum": [
        "welcome",
        "dictation",
        "trial",
        "done"
      ],
      "type": "string"
    }
  },
  "properties": {
    "progress": {
      "anyOf": [
        {
          "$ref": "#/definitions/SetupProgress"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "version": {
      "format": "uint8",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "revision",
    "version"
  ],
  "title": "SetupSnapshot",
  "type": "object"
}
