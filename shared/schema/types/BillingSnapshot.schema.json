        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "emailMasked": {
          "type": [
            "string",
            "null"
          ]
        },
        "emailRequired": {
          "type": "boolean"
        },
        "firstCharge": {
          "type": "string"
        },
        "handoff": {
          "type": "string"
