{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Acceleration": {
      "enum": [
        "automatic",
        "cpu",
        "gpu"
      ],
      "type": "string"
    },
    "Duration": {
      "enum": [
        "local",
        "styles",
        "unlimited"
      ],
      "type": "string"
    },
    "Login": {
      "enum": [
        "enabled",
        "disabled",
        "approvalRequired",
        "unavailable"
      ],
      "type": "string"
    },
    "Marker": {
      "enum": [
        "off",
        "microphone",
        "text"
      ],
      "type": "string"
    },
    "Microphone": {
      "enum": [
        "authorized",
        "notDetermined",
        "denied",
        "restricted",
        "unknown"
      ],
      "type": "string"
    },
    "MicrophoneDevice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "Pause": {
      "description": "The pause after speech: how long the silence lasts before a piece of speech is cut. One set for the phone and the computer. Auto is 1 s where every piece is inserted as it is recognized and 2 s where the text is inserted at the end: a thinking pause then no longer ends a sentence (stray sentence ends 22 to 12 on the dictation-pauses corpus, 29 Oct 2026).",
      "enum": [
        "auto",
        "short",
        "medium",
        "long"
      ],
      "type": "string"
    },
    "Permissions": {
      "additionalProperties": false,
      "properties": {
        "accessibility": {
          "type": "boolean"
        },
        "microphone": {
          "$ref": "#/definitions/Microphone"
        }
      },
      "required": [
        "accessibility",
        "microphone"
      ],
      "type": "object"
    }
  },
  "properties": {
    "acceleration": {
      "$ref": "#/definitions/Acceleration"
    },
    "alwaysOnMicrophone": {
      "type": "boolean",
      "x-serde-omitted": true
    },
    "durationMode": {
      "$ref": "#/definitions/Duration"
    },
    "inputChannel": {
      "format": "uint32",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ],
      "x-serde-omitted": true
    },
    "inputChannels": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer",
      "x-serde-omitted": true
    },
    "launchAtLogin": {
      "$ref": "#/definitions/Login"
    },
    "markerMinimum": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "maxMinutes": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "microphoneId": {
      "type": [
        "string",
        "null"
      ]
    },
    "microphones": {
      "items": {
        "$ref": "#/definitions/MicrophoneDevice"
      },
      "type": "array"
    },
    "modelUnloadMinutes": {
      "description": "Idle minutes before the recognition model is released; 0 keeps it loaded.",
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "muteAudio": {
      "type": "boolean"
    },
    "pause": {
      "allOf": [
        {
          "$ref": "#/definitions/Pause"
        }
      ],
      "default": "auto"
    },
    "permissions": {
      "$ref": "#/definitions/Permissions"
    },
    "playSounds": {
      "type": "boolean"
    },
    "pushToTalk": {
      "type": "boolean",
      "x-serde-omitted": true
    },
    "voiceMarker": {
      "$ref": "#/definitions/Marker"
    }
  },
  "required": [
    "acceleration",
    "durationMode",
    "launchAtLogin",
    "markerMinimum",
    "maxMinutes",
    "microphones",
    "modelUnloadMinutes",
    "muteAudio",
    "permissions",
    "playSounds",
    "voiceMarker"
  ],
  "title": "DictationSnapshot",
  "type": "object"
}
