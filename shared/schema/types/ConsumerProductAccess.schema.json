    },
    "consumedTotal": {
      "format": "int32",
      "type": "integer"
    },
    "dailyLimit": {
      "format": "int32",
      "type": "integer"
    },
    "day": {
      "type": "string"
    },
    "deviceDays": {
      "additionalProperties": {
        "format": "int32",
