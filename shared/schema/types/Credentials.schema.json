{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Host/private-storage transport only. Never serialize into a renderer event. Deliberately does not implement Debug or Display.",
  "properties": {
    "accessToken": {
      "type": "string"
    },
    "deviceId": {
      "default": "",
      "type": "string"
    },
    "deviceLimit": {
      "default": 0,
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "displayName": {
      "default": "",
      "type": "string"
    },
    "refreshToken": {
      "type": "string"
    }
  },
  "required": [
    "accessToken",
    "refreshToken"
  ],
  "title": "Credentials",
  "type": "object",
  "x-consumer-field-order": null,
  "x-consumer-view": true,
  "x-kotlin-defaults": {}
}
