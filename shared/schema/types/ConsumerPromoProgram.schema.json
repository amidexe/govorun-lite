{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ConsumerPromoFeature": {
      "description": "One «что входит» line from the server: an icon key from the app's short list, a name and a short detail.",
      "properties": {
        "detail": {
          "default": "",
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "icon",
        "title"
      ],
      "type": "object"
    }
  },
  "properties": {
    "accessDays": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "accessEndsAt": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "accessMode": {
      "default": "common_end",
      "type": "string"
    },
    "activationAvailable": {
      "default": false,
      "type": "boolean"
    },
    "campaignId": {
      "default": "",
      "type": "string"
    },
    "canActivate": {
      "default": false,
      "type": "boolean"
    },
    "dailyLimit": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "endsAt": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "enrollmentOpen": {
      "default": false,
      "type": "boolean"
    },
    "features": {
      "default": [],
      "description": "What the access gives, line by line, from the server (program control); empty shows no lines.",
      "items": {
        "$ref": "#/definitions/ConsumerPromoFeature"
      },
      "type": "array"
    },
    "message": {
      "default": "",
      "type": "string"
    },
    "participated": {
      "default": false,
      "type": "boolean"
    },
    "periodDays": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "periodLimit": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "programVersion": {
      "default": "",
      "type": "string"
    },
    "state": {
      "default": "disabled",
      "type": "string"
    },
    "visible": {
      "default": false,
      "type": "boolean"
    }
  },
  "title": "ConsumerPromoProgram",
  "type": "object",
  "x-consumer-field-order": [
    "campaignId",
    "programVersion",
    "state",
    "enrollmentOpen",
    "activationAvailable",
    "participated",
    "accessMode",
    "accessDays",
    "accessEndsAt",
    "endsAt",
    "dailyLimit",
    "periodLimit",
    "periodDays",
    "message",
    "visible",
    "canActivate",
    "features"
  ],
  "x-consumer-view": true,
  "x-kotlin-defaults": {}
}
