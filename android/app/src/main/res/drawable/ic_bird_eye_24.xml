<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurface">
    <!-- Tile-only variant of ic_bird_24: same silhouette, scaled to 85%
         around the viewport center to free up the top-right corner for
         the eye modifier. The base ic_bird_24 (used in the bubble overlay
         and brand) is untouched. -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.85"
        android:scaleY="0.85">
        <path
            android:strokeColor="@android:color/white"
            android:strokeWidth="1.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M21.5,10.5 L17.5,9 C14.5,5.5 9,5.5 6,9.5 L3,8.5 L4,12.5 C5.5,15.5 9,17.5 13,17.5 C16,17.5 18,15.5 18,13 L21.5,11.5 Z" />
        <path
            android:strokeColor="@android:color/white"
            android:strokeWidth="1.3"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M7.5,11.5 C9.5,13.5 12,14.5 15,14" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M15.2,9 m-0.7,0 a0.7,0.7 0 1,0 1.4,0 a0.7,0.7 0 1,0 -1.4,0 Z" />
    </group>
    <!-- Eye glyph in the top-right corner. Larger now that the bird is
         scaled down. Path edges sit 0.6 units inside the viewport on all
         sides to leave room for the 1.2-wide stroke (which paints
         half-out of the path centerline). -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M14.6,3.5 C16.5,0.6 21.5,0.6 23.4,3.5 C21.5,6.4 16.5,6.4 14.6,3.5 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19,3.5 m-1.3,0 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0 Z" />
</vector>
