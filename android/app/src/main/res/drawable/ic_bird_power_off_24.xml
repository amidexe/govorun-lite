<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurface">
    <!-- Tile-only variant of ic_bird_24: same silhouette, scaled to 85%
         around the viewport center to free up the top-right corner for
         the power-off modifier. The base ic_bird_24 (used in the bubble
         overlay and brand) is untouched. -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.85"
        android:scaleY="0.85">
        <path
            android:strokeColor="@android:color/white"
            android:strokeWidth="1.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M21.5,10.5 L17.5,9 C14.5,5.5 9,5.5 6,9.5 L3,8.5 L4,12.5 C5.5,15.5 9,17.5 13,17.5 C16,17.5 18,15.5 18,13 L21.5,11.5 Z" />
        <path
            android:strokeColor="@android:color/white"
            android:strokeWidth="1.3"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M7.5,11.5 C9.5,13.5 12,14.5 15,14" />
        <path
            android:fillColor="@android:color/white"
            android:pathData="M15.2,9 m-0.7,0 a0.7,0.7 0 1,0 1.4,0 a0.7,0.7 0 1,0 -1.4,0 Z" />
    </group>
    <!-- Power-off glyph in top-right. Radius 3, centered around (19, 4).
         Arc top sits at y=1, vertical bar from y=0.5 down through the gap.
         Path edges sit 0.6 units inside the viewport for the 1.2 stroke. -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M21,1.4 A3,3 0 1,1 17,1.4" />
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M19,0.6 L19,4" />
</vector>
