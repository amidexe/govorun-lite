<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- «слово / слова / слов» — Russian needs all four quantity buckets
         because the plural rule branches on last-digit AND last-two-digits.
         %1$s carries a pre-formatted thousands-separated number so the
         plural consumer doesn't need to know the formatting details. -->
    <plurals name="words_count">
        <item quantity="one">%1$s слово</item>
        <item quantity="few">%1$s слова</item>
        <item quantity="many">%1$s слов</item>
        <item quantity="other">%1$s слова</item>
    </plurals>

    <!-- Subtitle under the «minutes» stat. Switches to hours when the
         counter crosses 60 minutes — keeps the displayed number compact
         and stops «21600» from ever appearing. -->
    <plurals name="minutes_label">
        <item quantity="one">минута диктовки</item>
        <item quantity="few">минуты диктовки</item>
        <item quantity="many">минут диктовки</item>
        <item quantity="other">минут диктовки</item>
    </plurals>

    <plurals name="hours_label">
        <item quantity="one">час диктовки</item>
        <item quantity="few">часа диктовки</item>
        <item quantity="many">часов диктовки</item>
        <item quantity="other">часов диктовки</item>
    </plurals>

</resources>
