<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#FFFFFF</color>
    <!-- Standard amber for the "rate us" star. Stays consistent in light/dark
         themes — RuStore/Play associate this colour with ratings. -->
    <color name="star_amber">#FFC107</color>
    <!-- Semantic "do this" green used on the accessibility step's checklist.
         Balances the colorError red on the "don't enable" row so both
         instructions are equally scannable. We don't rely on colorPrimary
         because Dynamic Colors can make it any hue (pink, blue, yellow…). -->
    <color name="success_green">#2E7D32</color>
    <!-- Monochrome palette for views drawn outside Compose (the floating bird).
         Mirrors ProductTheme; Dynamic Colors replaces it when enabled. -->
    <color name="govorun_primary">#5F5F5F</color>
    <color name="govorun_on_primary">#F9F9F9</color>
    <color name="govorun_primary_container">#EBEBEB</color>
    <color name="govorun_on_primary_container">#575757</color>
    <color name="govorun_on_surface">#323232</color>
    <color name="govorun_surface_container_high">#EEEEEE</color>
</resources>
